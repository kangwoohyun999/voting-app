# Copy to .env.local and fill in.

# Neon Postgres connection string. Apply the schema with `npm run db:migrate`.
DATABASE_URL=

# Public address used in emailed links. Optional in development (taken from the request).
APP_URL=

# SMTP from a Gmail account made just for this app (needs 2-step verification + an app password).
# Without these, development prints emails to the console instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
